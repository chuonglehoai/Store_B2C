<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hoaichuong</groupId>
        <artifactId>b2c-store</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>sm-core</artifactId>
    <packaging>jar</packaging>
    
    <name>sm-core</name>
    <description>B2C Store Core Logic (Services and Repositories)</description>

    <dependencies>
        <!-- Liên kết trực tiếp với module sm-core-model -->
        <dependency>
            <groupId>com.hoaichuong</groupId>
            <artifactId>sm-core-model</artifactId>
        </dependency>

        <!-- Spring Boot Data JPA (Bắt buộc cho Repository & @Query) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Dependency Injection (Chuẩn JSR-330 cho @Inject) -->
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- Thư viện xử lý chuỗi (StringUtils dùng trong UserServiceImpl) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- Thư viện xử lý mảng/list (CollectionUtils) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.4</version>
        </dependency>

        <!-- Thư viện Jsoup (Để dùng org.jsoup.helper.Validate trong UserServiceImpl) -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>

        <!-- Database H2 (Dùng cho môi trường dev/test) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Thư viện Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        
    </dependencies>
</project>